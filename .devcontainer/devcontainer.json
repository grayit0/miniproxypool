{
  "name": "proxypool",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "forwardPorts": [8000, 18801, 18802, 18803],
  "portsAttributes": {
    "8000": {
      "label": "proxypool-manager",
      "onAutoForward": "public"
    },
    "18801": {
      "label": "node1-proxy",
      "onAutoForward": "silent"
    },
    "18802": {
      "label": "node2-proxy",
      "onAutoForward": "silent"
    },
    "18803": {
      "label": "node3-proxy",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash scripts/codespace_up.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker", "golang.go"]
    }
  },
  "remoteUser": "vscode"
}
