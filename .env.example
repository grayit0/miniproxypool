# 复制成 .env 后按需修改，docker compose 会自动读取。

# GHCR 镜像前缀与标签（docker-compose.ghcr.yml 用）
IMAGE_PREFIX=ghcr.io/grayit0/miniproxypool
IMAGE_TAG=latest

# 节点对外地址：客户端该用什么地址连到节点的代理端口。
# 本机跑 = 127.0.0.1；公网服务器 = 那个服务器的公网 IP 或域名。
NODE1_EGRESS_HOST=127.0.0.1
NODE2_EGRESS_HOST=127.0.0.1
NODE3_EGRESS_HOST=127.0.0.1
NODE_REGION=local
