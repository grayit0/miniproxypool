# 统一换行符，避免 Windows 上检出成 CRLF 之后 shell 脚本报
# "bad interpreter: /usr/bin/env bash^M"。
* text=auto eol=lf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.go          text eol=lf
*.py          text eol=lf
*.toml        text eol=lf
*.md          text eol=lf
*.json        text eol=lf

*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

*.png binary
*.jpg binary
*.db  binary
